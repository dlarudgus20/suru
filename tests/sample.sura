.const
k_print = string "print"
k_measure = string "measure"
k_val = string "val"
k_msg = string "== suru-bc register sample =="
k_elapsed = string "elapsed(sec):"
k_pi = string "pi approximation:"
k_0 = number 0
k_1 = number 1
k_2 = number 2
k_4 = number 4
k_loop = number 120000

.chunk main 0 8
GETGLOBALK k_print 0
LOADK 1 k_msg
CALL 0 1 0
GETGLOBALK k_measure 0
CLOSURE 1 work
CALL 0 1 1
LOAD 2 0
GETGLOBALK k_print 0
LOADK 1 k_elapsed
LOAD 2 2
CALL 0 2 0
GETGLOBALK k_print 0
LOADK 1 k_pi
GETGLOBALK k_val 2
CALL 0 2 0

RETURN 0 0

.chunk work 0 10
LOADK 0 k_0
LOADK 1 k_0
LOADK 2 k_1
LOADK 3 k_loop
LOADK 4 k_2
LOADK 5 k_1
LOADK 6 k_4

loop_begin:
LT 9 0 3
IFFALSY 9
JMP loop_end
MUL 7 0 4
ADD 7 7 5
DIV 8 2 7
ADD 1 1 8
NEG 2 2
ADD 0 0 5
JMP loop_begin

loop_end:
MUL 7 1 6
SETGLOBALK k_val 7
RETURN 0 0