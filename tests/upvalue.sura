.const
k_print = string "print"
k_msg1 = string "first="
k_msg2 = string "second="
k_msg3 = string "third="
k_msg4 = string "fourth="
k_41 = number 41
k_100 = number 100
k_1 = number 1

.chunk main 0 8
LOADK 1 k_41
CLOSURE 0 inc
GETGLOBALK k_print 2
LOADK 3 k_msg1
LOAD 4 0
CALL 4 0 1
CALL 2 2 0
GETGLOBALK k_print 2
LOADK 3 k_msg2
LOAD 4 0
CALL 4 0 1
CALL 2 2 0
LOADK 1 k_100
GETGLOBALK k_print 2
LOADK 3 k_msg3
LOAD 4 0
CALL 4 0 1
CALL 2 2 0
GETGLOBALK k_print 2
LOADK 3 k_msg4
LOAD 4 0
CALL 4 0 1
CALL 2 2 0
RETURN 0 0

.chunk inc 0 2
.upvalue local 1
GETUPVAL 0 0
LOADK 1 k_1
ADD 0 0 1
SETUPVAL 0 0
RETURN 0 1