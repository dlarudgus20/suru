.const
k_print = string "print"
k_msg1 = string "first="
k_msg2 = string "second="
k_41 = number 41
k_1 = number 1

.chunk main 0 8 0
LOADK 1 k_41
CLOSURE 0 inc
GETGLOBAL 2 k_print
LOADK 3 k_msg1
MOVE 4 0
CALL 4 0 1
CALL 2 2 0
GETGLOBAL 2 k_print
LOADK 3 k_msg2
MOVE 4 0
CALL 4 0 1
CALL 2 2 0
RETURN 0 0

.chunk inc 0 2 1
GETUPVAL 0 0
LOADK 1 k_1
ADD 0 0 1
SETUPVAL 0 0
RETURN 0 1
