.const
k_div = string "div"
k_print = string "print"
k_msg_q = string "q="
k_msg_r = string "r="
k_7 = number 7
k_3 = number 3

.chunk main 0 8
GETGLOBALK k_div 0
LOADK 1 k_7
LOADK 2 k_3
CALL 0 2 2
GETGLOBALK k_print 3
LOADK 4 k_msg_q
LOAD 5 0
CALL 3 2 0
GETGLOBALK k_print 3
LOADK 4 k_msg_r
LOAD 5 1
CALL 3 2 0
RETURN 0 0